#!/usr/bin/env php
<?php
declare(strict_types=1);
$autoload = getcwd() . '/vendor/autoload.php';
if (!is_file($autoload)) {
    // Support direct checkout of the package as well as Composer installation.
    $autoload = dirname(__DIR__) . '/vendor/autoload.php';
}
if (!is_file($autoload)) {
    fwrite(STDERR, "Composer autoloader not found. Run composer install.\n");
    exit(1);
}
require $autoload;
exit((new DorsetDigital\SSDeploy\Application(dirname(__DIR__)))->run($argv));
